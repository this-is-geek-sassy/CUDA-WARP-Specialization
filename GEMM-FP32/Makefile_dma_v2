EXECUTABLE := gemm_fp_32_cudadma_v2
CUFILES := gemm_fp_32_cudaDMA_v2.cu

# Dataset size options:
# -DMINI_DATASET         32x32
# -DSMALL_DATASET        124x124
# -DSTANDARD_DATASET     512x512 (default)
# -DLARGE_DATASET        1024x1024
# -DEXTRALARGE_DATASET   2048x2048
# -DHUGE_DATASET         4096x4096
# -DHUMONGOUS_DATASET    8192x8192

DATASET := -DLARGE_DATASET

# Rectangular tile configuration
# Override these on command line: make TILE_M=64 TILE_N=64 TILE_K=16
# Note: For cudaDMAv2, use square tiles (32x32x32) to ensure proper thread coverage
TILE_M ?= 64
TILE_N ?= 32
TILE_K ?= 16
TILE_CONFIG := -DTILE_M=$(TILE_M) -DTILE_N=$(TILE_N) -DTILE_K=$(TILE_K)

ARCH := -gencode arch=compute_86,code=sm_89
CFLAGS := -O3

all:
	nvcc $(CFLAGS) $(DATASET) $(TILE_CONFIG) $(CUFILES) -o $(EXECUTABLE) $(ARCH)

clean:
	rm -f *~ $(EXECUTABLE)
